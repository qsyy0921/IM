{
  "name": "@nexusim/clients",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "web",
    "desktop",
    "android"
  ],
  "scripts": {
    "validate": "node ./tools/validate-client-workspace.mjs",
    "dev:web": "npm --workspace @nexusim/web run dev",
    "build:web": "npm --workspace @nexusim/web run build",
    "test:indexeddb-store": "npm --workspace @nexusim/web run test:indexeddb-store",
    "test:web-platform": "node ./tools/test-web-platform-adapter.mjs",
    "test:shell-config": "node ./tools/test-shell-config-contract.mjs",
    "test:shell-web-assets": "node ./tools/test-shell-web-assets.mjs",
    "verify:shell-assets": "node ./tools/verify-shell-assets.mjs --target all",
    "test:artifact-builders": "node ./tools/test-client-artifact-builders.mjs",
    "test:artifact-collector": "node ./tools/test-client-artifact-collector.mjs",
    "test:artifact-readiness": "node ./tools/test-client-artifact-readiness.mjs",
    "test:shell-smoke-plan": "node ./tools/test-client-shell-smoke-plan.mjs",
    "validate:builder-profile": "node ./tools/validate-client-builder-profile.mjs",
    "test:key-value-store": "node ./tools/test-key-value-message-store.mjs",
    "test:runtime-lifecycle": "node ./tools/test-client-runtime-lifecycle.mjs",
    "build:shell-assets:desktop": "node ./tools/prepare-shell-web-assets.mjs --target windows-desktop",
    "build:shell-assets:android": "node ./tools/prepare-shell-web-assets.mjs --target android",
    "build:desktop-artifact": "node ./tools/build-desktop-artifact.mjs",
    "build:android-apk": "node ./tools/build-android-apk.mjs",
    "build:desktop-artifact:collect": "node ./tools/build-desktop-artifact.mjs --collect",
    "build:android-apk:collect": "node ./tools/build-android-apk.mjs --collect",
    "collect:client-artifacts": "node ./tools/collect-client-artifacts.mjs",
    "report:artifact-readiness": "node ./tools/report-client-artifact-readiness.mjs",
    "plan:shell-smoke": "node ./tools/plan-client-shell-smoke.mjs",
    "typecheck:desktop": "npm --workspace @nexusim/desktop run typecheck",
    "validate:desktop-tauri": "npm --workspace @nexusim/desktop run validate:tauri",
    "typecheck:android": "npm --workspace @nexusim/android run typecheck",
    "validate:android-native": "npm --workspace @nexusim/android run validate:native",
    "check:build-prereqs": "node ./tools/check-client-build-prereqs.mjs",
    "typecheck": "npm --workspaces --if-present run typecheck"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
