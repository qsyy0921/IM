    "smoke:desktop-composed": "node ./tools/smoke-desktop-composed.mjs",
    "smoke:desktop-webview-metadata": "node ./tools/smoke-desktop-webview-metadata.mjs",
    "smoke:desktop-webview-login": "node ./tools/smoke-desktop-webview-login.mjs",
