{
  "name": "@nexusim/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "validate:tauri": "node ../tools/validate-desktop-tauri.mjs",
    "prepare:shell-assets:desktop": "node ../tools/prepare-shell-web-assets-if-needed.mjs --target windows-desktop",
    "prepare:web-assets": "npm run prepare:shell-assets:desktop",
    "build:shell-assets:desktop": "npm --prefix .. run build:shell-assets:desktop",
    "build:artifact": "npm --prefix .. run build:desktop-artifact",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@nexusim/client-core": "0.1.0",
    "@nexusim/protocol": "0.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.3"
  }
}
