{
  "schema_version": 1,
  "gate_id": "ai-eval-local-foundation-gate",
  "scope": "first-stage low-sensitive local AI eval gate; not a production CI gate or model-quality benchmark",
  "policy": {
    "min_case_count": 20,
    "max_failed_count": 0,
    "require_get_run": true,
    "require_list_run": true,
    "required_adapters": [
      "profile-agent-safety",
      "action-external-http-provider",
      "action-external-mcp-failure"
    ]
  },
  "adapters": [
    {
      "name": "profile-agent-safety",
      "required": true,
      "script": "run-ai-eval-profile-agent-safety.ps1",
      "run_suffix": "profile-agent-safety",
      "summary_file": "profile-agent-safety-eval-summary.json",
      "requires_service_stack": false
    },
    {
      "name": "action-external-http-provider",
      "required": true,
      "script": "run-ai-eval-action-external-adapter.ps1",
      "run_suffix": "action-external-http",
      "summary_file": "action-external-http-eval-summary.json",
      "requires_service_stack": false
    },
    {
      "name": "action-external-mcp-failure",
      "required": true,
      "script": "run-ai-eval-action-mcp-failure-adapter.ps1",
      "run_suffix": "action-external-mcp-failure",
      "summary_file": "action-external-mcp-failure-eval-summary.json",
      "requires_service_stack": false
    }
  ],
  "optional_service_stack_adapters": [
    {
      "name": "rag-service",
      "script": "run-ai-eval-rag-adapter.ps1",
      "run_suffix": "rag-service",
      "summary_file": "rag-eval-adapter-summary.json",
      "requires_service_stack": true,
      "requires": [
        "rag-service",
        "retrieval-gateway",
        "search-service",
        "memory-service",
        "postgres"
      ]
    },
    {
      "name": "summary-service",
      "script": "run-ai-eval-summary-adapter.ps1",
      "run_suffix": "summary-service",
      "summary_file": "summary-eval-adapter-summary.json",
      "requires_service_stack": true,
      "requires": [
        "summary-service",
        "retrieval-gateway",
        "search-service",
        "memory-service",
        "postgres"
      ]
    },
    {
      "name": "agent-action-executor",
      "script": "run-ai-eval-agent-adapter.ps1",
      "run_suffix": "agent-action-executor",
      "summary_file": "agent-eval-adapter-summary.json",
      "requires_service_stack": true,
      "requires": [
        "agent-service",
        "action-executor",
        "retrieval-gateway",
        "mcp-gateway",
        "skill-registry",
        "policy-service",
        "postgres"
      ]
    },
    {
      "name": "python-ai-worker",
      "script": "run-ai-eval-python-worker-adapter.ps1",
      "run_suffix": "python-ai-worker",
      "summary_file": "python-worker-eval-summary.json",
      "requires_service_stack": false,
      "requires": [
        "conda-env:IM"
      ]
    },
    {
      "name": "agent-python-worker-provider",
      "script": "run-ai-eval-agent-output-regression.ps1",
      "run_suffix": "agent-python-worker-provider",
      "summary_file": "agent-output-regression-summary.json",
      "requires_service_stack": false,
      "requires": [
        "conda-env:IM"
      ]
    },
    {
      "name": "action-preflight-safety",
      "script": "run-ai-eval-action-preflight-safety-adapter.ps1",
      "run_suffix": "action-preflight-safety",
      "summary_file": "action-preflight-safety-eval-summary.json",
      "requires_service_stack": false
    }
  ],
  "forbidden_persisted_fields": [
    "raw_prompt",
    "raw_evidencepack",
    "raw_model_output",
    "user_content",
    "secret",
    "tool_input",
    "provider_response_body"
  ]
}
