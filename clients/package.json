    "bundle:desktop": "node ./tools/package-desktop-bundle.mjs",
    "bundle:desktop:dry-run": "node ./tools/package-desktop-bundle.mjs --dry-run",
    "report:artifact-readiness": "node ./tools/report-client-artifact-readiness.mjs",
    "report:android-platform-readiness": "node ./tools/report-android-platform-readiness.mjs",
    "report:android-device-readiness": "node ./tools/report-android-device-readiness.mjs",
    "report:android-webview-devtools-readiness": "node ./tools/report-android-webview-devtools-readiness.mjs",
    "plan:shell-smoke": "node ./tools/plan-client-shell-smoke.mjs",
