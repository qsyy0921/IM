{
  "uid": "nexusim-delivery-service",
  "title": "NexusIM Delivery Service",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": ["nexusim", "delivery-service", "first-stage"],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "gRPC errors",
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "targets": [
        {
          "refId": "A",
          "expr": "increase(nexusim_delivery_grpc_method_errors_total[30m])",
          "legendFormat": "{{method}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Inbox rows",
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0},
      "targets": [
        {
          "refId": "A",
          "expr": "max(nexusim_delivery_read_model{state=\"user_inbox_total\"})",
          "legendFormat": "user_inbox"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Outbox DLQ",
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0},
      "targets": [
        {
          "refId": "A",
          "expr": "max(nexusim_delivery_outbox{state=\"dlq\"})",
          "legendFormat": "dlq"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Projection blockers",
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0},
      "targets": [
        {
          "refId": "A",
          "expr": "max(nexusim_delivery_projection_failures{state=\"unresolved_total\"})",
          "legendFormat": "unresolved"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "gRPC requests",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "targets": [
        {
          "refId": "A",
          "expr": "increase(nexusim_delivery_grpc_method_requests_total[30m])",
          "legendFormat": "{{method}}"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "short"},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "none"}
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "gRPC latency",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "targets": [
        {
          "refId": "A",
          "expr": "nexusim_delivery_grpc_latency_avg_milliseconds",
          "legendFormat": "avg {{method}}"
        },
        {
          "refId": "B",
          "expr": "nexusim_delivery_grpc_latency_max_milliseconds",
          "legendFormat": "max {{method}}"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "ms"},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "none"}
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Read model",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 14},
      "targets": [
        {
          "refId": "A",
          "expr": "nexusim_delivery_read_model",
          "legendFormat": "{{state}}"
        },
        {
          "refId": "B",
          "expr": "nexusim_delivery_membership_projection",
          "legendFormat": "membership {{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "short"},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "none"}
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Outbox rows",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 14},
      "targets": [
        {
          "refId": "A",
          "expr": "nexusim_delivery_outbox",
          "legendFormat": "{{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "short"},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "none"}
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Projection failures",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 14},
      "targets": [
        {
          "refId": "A",
          "expr": "nexusim_delivery_projection_failures",
          "legendFormat": "{{state}}"
        },
        {
          "refId": "B",
          "expr": "nexusim_delivery_projection_failures_by_class",
          "legendFormat": "{{class}}"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "short"},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "none"}
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "PostgreSQL pool connections",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 22},
      "targets": [
        {
          "refId": "A",
          "expr": "nexusim_delivery_pg_pool_conns",
          "legendFormat": "{{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "short"},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "none"}
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Worker / relay runtime",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 22},
      "targets": [
        {
          "refId": "A",
          "expr": "nexusim_delivery_timeline_worker_consecutive_errors",
          "legendFormat": "timeline consecutive"
        },
        {
          "refId": "B",
          "expr": "nexusim_delivery_outbox_relay_consecutive_errors",
          "legendFormat": "relay consecutive"
        },
        {
          "refId": "C",
          "expr": "nexusim_delivery_timeline_worker_last_error_backoff_milliseconds",
          "legendFormat": "timeline backoff"
        },
        {
          "refId": "D",
          "expr": "nexusim_delivery_outbox_relay_last_error_backoff_milliseconds",
          "legendFormat": "relay backoff"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "short"},
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "timeline backoff"},
            "properties": [{"id": "unit", "value": "ms"}]
          },
          {
            "matcher": {"id": "byName", "options": "relay backoff"},
            "properties": [{"id": "unit", "value": "ms"}]
          }
        ]
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "none"}
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "OTel enabled",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 22},
      "targets": [
        {
          "refId": "A",
          "expr": "max(nexusim_delivery_otel_traces_enabled)",
          "legendFormat": "enabled"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "bool"},
        "overrides": []
      },
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    }
  ]
}
